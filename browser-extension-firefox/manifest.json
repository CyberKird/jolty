{
  "manifest_version": 2,
  "name": "Jolty",
  "version": "1.0.1",
  "description": "Lets the Jolty desktop app work in this browser, with your logins. It talks only to Jolty on this computer.",
  "browser_specific_settings": { "gecko": { "id": "jolty@joltarise.com", "strict_min_version": "115.0" } },
  "permissions": ["tabs", "webNavigation", "webRequest", "storage", "<all_urls>"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["driver.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": true }],
  "browser_action": {
    "default_title": "Jolty",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
