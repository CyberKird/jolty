{
  "manifest_version": 3,
  "name": "Jolty",
  "version": "1.0.1",
  "description": "Lets the Jolty desktop app work in this browser, with your logins. It talks only to Jolty on this computer.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Jolty",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
