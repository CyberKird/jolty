{
  "name": "jolty",
  "productName": "Jolty",
  "version": "0.11.0",
  "description": "Desktop app for Claude Code and Codex: multiple profiles, API keys, model picker, usage dashboard",
  "author": "CyberKird",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "node scripts/fetch-redist.mjs && electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "node scripts/fetch-whisper-mac.mjs && electron-vite build && electron-builder --mac --publish never",
    "dist:build": "node scripts/fetch-redist.mjs && electron-vite build && electron-builder --win --x64 --publish always",
    "dist:release": "node scripts/release.mjs",
    "test": "npm run test:store && npm run test:agent && npm run test:power && npm run test:profile-processes && npm run test:codex-lifecycle && npm run test:preview && npm run test:updater && npm run test:eta && npm run test:handoff && npm run test:gemini-learning && npm run test:workers && npm run test:changelog && npm run test:gemini && npm run test:models && npm run test:links-unit && npm run test:gemini-web && npm run test:computer && npm run test:improve && npm run test:chat-tools-unit && npm run test:stop && npm run test:compaction && npm run test:firstrun && npm run test:pack && npm run test:backup && npm run test:backup-providers && npm run test:skills && npm run test:firefox && npm run test:i18n && npm run test:release",
    "test:store": "esbuild test/store-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outfile=out-test/store-test.mjs --log-level=warning && node --test out-test/store-test.mjs",
    "test:agent": "esbuild test/agent-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --external:ws --outfile=out-test/agent-test.mjs --log-level=warning && node --test out-test/agent-test.mjs",
    "test:power": "node test/jbrowser/run.mjs test/power-test.ts --test",
    "test:browser": "node test/jbrowser/run.mjs test/jbrowser/tools-test.ts --test",
    "test:profile-processes": "esbuild test/profile-processes-test.ts --bundle --platform=node --format=cjs --outfile=out-test/profile-processes-test.cjs --log-level=warning && node --test out-test/profile-processes-test.cjs",
    "test:account-removal": "electron-vite build && node test/account-removal-test.mjs",
    "test:gemini-learning": "esbuild test/gemini-learning-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/gemini-learning-test.cjs --log-level=warning && node --test out-test/gemini-learning-test.cjs",
    "test:handoff": "esbuild test/handoff-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/handoff-test.cjs --log-level=warning && node --test out-test/handoff-test.cjs",
    "test:preview": "esbuild test/preview-test.ts --bundle --platform=node --format=cjs --outfile=out-test/preview-test.cjs --log-level=warning && node --test out-test/preview-test.cjs",
    "test:eta": "esbuild test/eta-test.ts --bundle --platform=node --alias:@shared=./src/shared --format=cjs --outfile=out-test/eta-test.cjs --log-level=warning && node --test out-test/eta-test.cjs",
    "test:models": "esbuild test/model-watch-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/model-watch-test.cjs --log-level=warning && node --test out-test/model-watch-test.cjs",
    "test:links-unit": "esbuild test/links-unit-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/links-unit-test.cjs --log-level=warning && node --test out-test/links-unit-test.cjs",
    "test:gemini-web": "esbuild test/gemini-web-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --external:ws --outfile=out-test/gemini-web-test.mjs --log-level=warning && node --test out-test/gemini-web-test.mjs",
    "test:ask-model": "esbuild test/ask-model-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --external:ws --outfile=out-test/ask-model-test.mjs --log-level=warning && node --test out-test/ask-model-test.mjs",
    "test:changelog": "esbuild test/changelog-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/changelog-test.cjs --log-level=warning && node --test out-test/changelog-test.cjs",
    "test:codex-lifecycle": "esbuild test/codex-lifecycle-test.ts --bundle --platform=node --format=cjs --external:electron --external:@playwright/mcp --alias:@shared=./src/shared --outfile=out-test/codex-lifecycle-test.cjs --log-level=warning && node --test out-test/codex-lifecycle-test.cjs",
    "test:codex-ui": "electron-vite build && node test/codex-ui-test.mjs",
    "test:engines": "esbuild test/engine-test.ts --bundle --platform=node --format=cjs --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@playwright/mcp --alias:@shared=./src/shared --outfile=out-test/engine-test.js --log-level=warning && electron --no-sandbox out-test/engine-test.js",
    "test:acp": "esbuild test/acp-test.ts --bundle --platform=node --format=cjs --external:electron --alias:@shared=./src/shared --outfile=out-test/acp-test.cjs --log-level=warning && node --test out-test/acp-test.cjs",
    "test:ui": "electron-vite build && node test/ui-test.mjs",
    "test:links": "electron-vite build && node test/links-test.mjs",
    "test:mascot": "electron-vite build && node test/mascot-test.mjs",
    "test:obstruct": "electron-vite build && node test/mascot-obstruct-test.mjs",
    "test:live": "electron-vite build && node test/live-test.mjs",
    "test:sessions": "electron-vite build && node test/sessions-test.mjs",
    "test:plan": "electron-vite build && node test/plan-test.mjs",
    "test:livecode": "electron-vite build && node test/livecode-test.mjs",
    "test:release": "node --test test/release-version-test.mjs",
    "test:resize": "electron-vite build && node test/resize-test.mjs",
    "test:scroll": "electron-vite build && node test/scroll-test.mjs",
    "test:transitions": "electron-vite build && node test/transitions-test.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "test:gemini": "esbuild test/gemini-vision-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/gemini-vision-test.cjs --log-level=warning && node --test out-test/gemini-vision-test.cjs",
    "test:computer": "esbuild test/computer-human-test.ts test/computer-gate-test.ts test/computer-release-test.ts test/computer-headsup-test.ts test/computer-displays-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outdir=out-test --log-level=warning && node --test out-test/computer-human-test.js out-test/computer-gate-test.js out-test/computer-release-test.js out-test/computer-headsup-test.js out-test/computer-displays-test.js",
    "test:chat-tools-unit": "esbuild test/chat-tools-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/chat-tools-test.cjs --log-level=warning && node --test out-test/chat-tools-test.cjs",
    "test:chat-tools": "electron-vite build && node test/chat-tools-ui.mjs",
    "test:improve": "esbuild test/improve-prompt-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/improve-prompt-test.cjs --log-level=warning && node --test out-test/improve-prompt-test.cjs",
    "test:compaction": "esbuild test/compaction-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/compaction-test.cjs --log-level=warning && node --test out-test/compaction-test.cjs",
    "test:stop": "esbuild test/stop-gate-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/stop-gate-test.cjs --log-level=warning && node --test out-test/stop-gate-test.cjs",
    "test:firstrun": "esbuild test/first-run-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outfile=out-test/first-run-test.mjs --log-level=warning && node --test out-test/first-run-test.mjs",
    "test:firefox": "esbuild test/firefox-pair-test.ts --bundle --platform=node --format=cjs --external:ws --outfile=out-test/firefox-pair-test.cjs --log-level=warning && node --test out-test/firefox-pair-test.cjs",
    "test:pack": "esbuild test/pack-test.ts --bundle --platform=node --format=cjs --external:electron --alias:@shared=./src/shared --outfile=out-test/pack-test.cjs --log-level=warning && node --test out-test/pack-test.cjs",
    "test:backup": "esbuild test/backup-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outfile=out-test/backup-test.mjs --log-level=warning && node --test out-test/backup-test.mjs",
    "test:backup-providers": "esbuild test/backup-providers/*-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outdir=out-test/backup-providers --out-extension:.js=.mjs --log-level=warning && node --test \"out-test/backup-providers/*.mjs\"",
    "test:skills": "esbuild test/skills-test.ts --bundle --platform=node --format=cjs --external:electron --alias:@shared=./src/shared --outfile=out-test/skills-test.cjs --log-level=warning && node --test out-test/skills-test.cjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "test:updater": "esbuild test/updater-test.ts --bundle --platform=node --format=cjs --alias:electron=./test/updater-stubs.ts --alias:electron-updater=./test/updater-stubs.ts --alias:@shared=./src/shared --outfile=out-test/updater-test.cjs --log-level=warning && node --test out-test/updater-test.cjs",
    "test:workers": "esbuild test/workers-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outfile=out-test/workers-test.mjs --log-level=warning && node --test out-test/workers-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@openai/codex": "^0.163.0",
    "@playwright/mcp": "0.0.82",
    "electron-updater": "6.8.9",
    "planck": "^1.5.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
