{
  "name": "jolty",
  "productName": "Jolty",
  "version": "0.7.5",
  "description": "Desktop app for Claude Code and Codex: multiple profiles, API keys, model picker, usage dashboard",
  "author": "CyberKird",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "node scripts/fetch-redist.mjs && electron-vite build && electron-builder --win --x64 --publish never",
    "dist:release": "node scripts/fetch-redist.mjs && electron-vite build && electron-builder --win --x64 --publish always",
    "test": "npm run test:store && npm run test:agent && npm run test:power && npm run test:profile-processes && npm run test:codex-lifecycle && npm run test:preview && npm run test:updater && npm run test:eta && npm run test:handoff && npm run test:changelog && npm run test:i18n",
    "test:store": "esbuild test/store-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --outfile=out-test/store-test.mjs --log-level=warning && node --test out-test/store-test.mjs",
    "test:agent": "esbuild test/agent-test.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --external:ws --outfile=out-test/agent-test.mjs --log-level=warning && node --test out-test/agent-test.mjs",
    "test:power": "node test/jbrowser/run.mjs test/power-test.ts --test",
    "test:browser": "node test/jbrowser/run.mjs test/jbrowser/tools-test.ts --test",
    "test:profile-processes": "esbuild test/profile-processes-test.ts --bundle --platform=node --format=cjs --outfile=out-test/profile-processes-test.cjs --log-level=warning && node --test out-test/profile-processes-test.cjs",
    "test:account-removal": "electron-vite build && node test/account-removal-test.mjs",
    "test:handoff": "esbuild test/handoff-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/handoff-test.cjs --log-level=warning && node --test out-test/handoff-test.cjs",
    "test:preview": "esbuild test/preview-test.ts --bundle --platform=node --format=cjs --outfile=out-test/preview-test.cjs --log-level=warning && node --test out-test/preview-test.cjs",
    "test:eta": "esbuild test/eta-test.ts --bundle --platform=node --alias:@shared=./src/shared --format=cjs --outfile=out-test/eta-test.cjs --log-level=warning && node --test out-test/eta-test.cjs",
    "test:changelog": "esbuild test/changelog-test.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --outfile=out-test/changelog-test.cjs --log-level=warning && node --test out-test/changelog-test.cjs",
    "test:codex-lifecycle": "esbuild test/codex-lifecycle-test.ts --bundle --platform=node --format=cjs --external:electron --external:@playwright/mcp --alias:@shared=./src/shared --outfile=out-test/codex-lifecycle-test.cjs --log-level=warning && node --test out-test/codex-lifecycle-test.cjs",
    "test:codex-ui": "electron-vite build && node test/codex-ui-test.mjs",
    "test:engines": "esbuild test/engine-test.ts --bundle --platform=node --format=cjs --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@playwright/mcp --alias:@shared=./src/shared --outfile=out-test/engine-test.js --log-level=warning && electron --no-sandbox out-test/engine-test.js",
    "test:hermes": "esbuild test/hermes-test.ts --bundle --platform=node --format=cjs --external:electron --alias:@shared=./src/shared --outfile=out-test/hermes-test.cjs --log-level=warning && node --test out-test/hermes-test.cjs",
    "test:ui": "electron-vite build && node test/ui-test.mjs",
    "test:links": "electron-vite build && node test/links-test.mjs",
    "test:mascot": "electron-vite build && node test/mascot-test.mjs",
    "test:livecode": "electron-vite build && node test/livecode-test.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "test:updater": "esbuild test/updater-test.ts --bundle --platform=node --format=cjs --alias:electron=./test/updater-stubs.ts --alias:electron-updater=./test/updater-stubs.ts --alias:@shared=./src/shared --outfile=out-test/updater-test.cjs --log-level=warning && node --test out-test/updater-test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@openai/codex": "^0.163.0",
    "@playwright/mcp": "0.0.82",
    "electron-updater": "6.8.9",
    "planck": "^1.5.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
